# Port for the local overlay HTTP server
# Open http://127.0.0.1:5000 in OBS as a Browser Source (enable "Allow transparency")
OVERLAY_PORT='5000'

# Set to 'True' to use a test log file instead of the live game log
TEST_LOG_FLAG='False'

# Path to a test log file (only used when TEST_LOG_FLAG is True)
# For development, point this at test_game.log and drive it with test_runner.py:
#   python test_runner.py   (in one terminal)
#   python main.py          (in another terminal, started during the countdown)
TEST_LOG_FILEPATH='test_game.log'
